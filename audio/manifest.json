{
  "version": "5.6.0",
  "engine": "TELKIN_AUDIO",
  "formatPriority": ["ogg", "mp3", "wav"],
  "buses": {
    "master": 0.72,
    "ambience": 0.85,
    "sfx": 0.92,
    "voice": 1.0,
    "music": 0.65,
    "ui": 0.55
  },
  "policy": {
    "autoplay": "user-gesture-only",
    "storyGate": false,
    "missingMedia": "procedural-or-silent-fallback",
    "lazyLoad": true
  },
  "voice": {
    "languages": ["tr", "en"],
    "pathTemplate": "audio/voice/{lang}/{character}/chapter-{chapter3}/cue-{cue2}.{ext}",
    "characters": ["mahir", "mina", "nisan", "baran", "kayitci", "eren", "leyla", "selin", "suna", "muhafiz", "doktor"]
  },
  "mediaOverrides": {
    "ambience": {},
    "sfx": {},
    "music": {},
    "voice": {}
  }
}
